# ======================================================================
# ConfiguraciÃ³n base - Agente OdontolÃ³gico IA
# Copiar a .env y editar valores segÃºn el consultorio
# ======================================================================

# ---- AplicaciÃ³n ----
NODE_ENV=development
APP_NAME="Consultorio Dental"
APP_PORT=3000
APP_TZ=America/Mexico_City
LOG_LEVEL=info

# ---- Base de datos ----
# Por defecto SQLite. Cambiar a postgres si se requiere.
DATABASE_URL=./storage/clinic.sqlite
DATABASE_DRIVER=sqlite

# ---- LLM Provider ----
# Valores vÃ¡lidos: ollama | anthropic | openai
LLM_PROVIDER=ollama
# Valores vÃ¡lidos: ollama | anthropic | openai | mock
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Modelos 'thinking' (qwen3...): false = respuestas rápidas sin razonamiento oculto
LLM_THINKING=false

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434


# ---- OpenRouter (gateway multi-model, tiene modelos :free) ----
# 1. Crea tu API key gratis en: https://openrouter.ai/keys
# 2. LLM_PROVIDER=openrouter
# 3. Elige un modelo gratuito (terminan en :free), ej:
#    meta-llama/llama-3.3-70b-instruct:free   (70B, muy capaz)
#    qwen/qwen-2.5-72b-instruct:free          (buen español)
#    google/gemini-2.0-flash-exp:free         (rápido)
#    deepseek/deepseek-chat-v3-0324:free      (excelente razonamiento)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Failover: si el modelo principal falla/rate-limita, prueba estos en orden
OPENROUTER_MODELS=z-ai/glm-5.2:free,minimax/minimax-m3:free

# Anthropic (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Canales ----
# WhatsApp Baileys
WA_ENABLED=true
WA_SESSION_PATH=./storage/wa-session

# WebSocket
WS_ENABLED=true
WS_PORT=3001

# ---- Agente ----
AGENT_MAX_ITERATIONS=8
AGENT_TOKEN_BUDGET=4096
AGENT_MEMORY_WINDOW=20

# ---- Job Queue ----
JOB_POLL_INTERVAL_MS=5000

# ---- Seguridad ----
ADMIN_TOKEN=change-me-in-production
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=30

# ---- Pagos (opcional) ----
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=

# ---- Calendar (opcional) ----
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---- Observabilidad ----
OTEL_ENABLED=false
OTEL_EXPORTER=console
SENTRY_DSN=
