{
  "name": "@dentist/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API - Agente Odontológico",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:dev": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "10.3.10",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.10",
    "@nestjs/event-emitter": "2.0.4",
    "@nestjs/platform-express": "10.3.10",
    "@nestjs/platform-ws": "10.3.10",
    "@nestjs/schedule": "4.0.2",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "5.1.2",
    "@nestjs/websockets": "10.3.10",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "better-sqlite3": "11.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.30.10",
    "nestjs-pino": "4.0.0",
    "pino": "9.1.0",
    "pino-http": "10.1.0",
    "pino-pretty": "11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "10.0.0",
    "ws": "8.17.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.10",
    "@swc/core": "1.5.7",
    "@types/better-sqlite3": "7.6.10",
    "@types/express": "4.17.21",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "drizzle-kit": "0.21.4",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.2",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.7.2",
    "typescript": "5.4.5",
    "unplugin-swc": "1.4.5",
    "vitest": "1.6.0"
  }
}
